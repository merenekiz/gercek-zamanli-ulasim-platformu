# Server Configuration
NODE_ENV=development
PORT=5001
API_VERSION=v1

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gercek_zamanli_ulasim_db

# Database - MongoDB
MONGODB_URI=mongodb://admin:your_secure_password_here@localhost:27017/gercek_zamanli_ulasim_realtime?authSource=admin

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# JWT Authentication
# Güvenlik önemlidir! Uzun ve rastgele bir string kullanın
JWT_SECRET=your_jwt_secret_here_make_it_long_and_random_minimum_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Google Maps Platform API
# Tek API Key tüm servisleri kapsar:
# - Directions API (Transit Mode) - Toplu taşıma rota planlama
# - Places API (Autocomplete) - Konum arama
# - Geocoding API - Adres ↔ Koordinat dönüşümü
# - Maps JavaScript API - Frontend harita gösterimi
#
# Ücretsiz limitler (Essentials):
# - Her API için 10,000 requests/month
# - Toplam 40,000 requests/month (4 API × 10,000)
#
# API Key almak için: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Uber API
UBER_CLIENT_ID=your_uber_client_id
UBER_CLIENT_SECRET=your_uber_client_secret
UBER_SERVER_TOKEN=your_uber_server_token

# Bolt API
BOLT_API_KEY=your_bolt_api_key
BOLT_API_SECRET=your_bolt_api_secret

# Public Transport Data
ANKARA_OPEN_DATA_API=https://api.akillisehir.gov.tr/
ANKARA_OPEN_DATA_KEY=your_open_data_api_key

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# WebSocket
WS_PORT=5001

# Cron Jobs
ENABLE_CRON_JOBS=true
VEHICLE_UPDATE_INTERVAL=30000
FARE_UPDATE_INTERVAL=86400000

# Feature Flags
ENABLE_UBER=true
ENABLE_BOLT=true
ENABLE_TAXI=true
ENABLE_REAL_TIME_TRACKING=true
