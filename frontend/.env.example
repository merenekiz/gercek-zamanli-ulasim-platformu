# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_WS_URL=ws://localhost:5000

# Google Maps API
# Backend ile AYNI API Key kullanılır
# Maps JavaScript API (harita gösterimi) için gereklidir
# API Key almak için: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Application Settings
NEXT_PUBLIC_APP_NAME=Ankara Ulaşım Platformu
NEXT_PUBLIC_DEFAULT_CITY=Ankara
NEXT_PUBLIC_DEFAULT_LAT=39.9334
NEXT_PUBLIC_DEFAULT_LNG=32.8597

# Feature Flags
NEXT_PUBLIC_ENABLE_UBER=true
NEXT_PUBLIC_ENABLE_BOLT=true
NEXT_PUBLIC_ENABLE_TAXI=true
NEXT_PUBLIC_ENABLE_PUBLIC_TRANSPORT=true

# Environment
NODE_ENV=development
